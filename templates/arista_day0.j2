! Lab 8 Day-0: sensitive account hashes; restricted runtime storage only.
hostname {{ device.hostname }}
!
interface Management0
   ip address {{ device.management.ipv4_prefix }}
   no shutdown
!
aaa authentication login default local
aaa authorization commands all default local
aaa authorization config-commands
no aaa authentication policy local allow-nopassword-remote-login
!
username admin privilege 15 role network-admin secret sha512 {{ day0_hashes['admin'] }}
username netpilot-recovery privilege 15 role network-admin secret sha512 {{ day0_hashes['netpilot-recovery'] }}
!
management ssh
   authentication empty-passwords deny
   no shutdown
!
snmp-server local-interface Management0
!
management api gnmi
   transport grpc default
      no ssl profile
!
management api http-commands
   protocol https
   no protocol http
   no shutdown
!
end
