# ==========================================
# NetPilot Git Ignore
# ==========================================

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env
.env.*
!.env.example

# Local credential/token files
scriptes.txt
zzprompt.txt

# Secrets / credentials
secrets/
credentials/
credentials.json
*_secret*
*_token*

# Containerlab generated runtime data
clab-pilot-network/
.clab/
clab-*/

# Temporary query/export files
query.csv
zzprompt.txt

# Logs
*.log
*.log.gz
logs/

# Local configuration-change audit records
/config_changes/

# Local RCN-5840 rollback journal and completion records
/runtime/maintenance/

# Temporary files
*.tmp
*.swp
*~

# IDE
.vscode/
.idea/

# OS
.DS_Store
